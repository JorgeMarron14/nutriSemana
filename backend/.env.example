PORT=3000
MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/nutrisemana
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Unico usuario de la app. Genera el hash con:
#   node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
AUTH_EMAIL=tu@email.com
AUTH_PASSWORD_HASH=

ANTHROPIC_API_KEY=sk-ant-...

# Opcionales, valores por defecto ya orientados a este proyecto:
# CLAUDE_DIET_PARSING_MODEL=claude-sonnet-5
# CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001
# CLAUDE_INGREDIENT_MODEL=claude-haiku-4-5-20251001
